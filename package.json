{
  "name": "soap-studio",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@soap-studio/web",
    "dev:admin": "turbo dev --filter=@soap-studio/admin",
    "build": "turbo build",
    "lint": "turbo lint",
    "seed": "tsx packages/db/src/seed.ts"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}

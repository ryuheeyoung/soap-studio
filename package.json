{
  "name": "soap-studio",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@soap-studio/web",
    "dev:admin": "turbo dev --filter=@soap-studio/admin",
    "build": "turbo build",
    "lint": "turbo lint",
    "seed": "tsx packages/db/src/seed.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "turbo": "^2"
  },
  "lint-staged": {
    "apps/admin/**/*.{ts,tsx}": "eslint --max-warnings=0 --no-warn-ignored",
    "apps/web/**/*.{ts,tsx}": "eslint --max-warnings=0 --no-warn-ignored",
    "packages/**/*.{ts,tsx}": "eslint --max-warnings=0 --no-warn-ignored"
  }
}
